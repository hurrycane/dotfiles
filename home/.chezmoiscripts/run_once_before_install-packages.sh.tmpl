#!/usr/bin/env bash
# Installs the CLI stack before chezmoi writes any config that depends on it.
# run_once_: re-runs only when this script's contents change.
{{- if eq .chezmoi.os "darwin" }}
set -euo pipefail

# Homebrew is installed by hand before chezmoi -- see README.
if ! command -v brew >/dev/null 2>&1; then
    echo "==> Homebrew not found. Install it first, then re-run chezmoi apply." >&2
    exit 1
fi

# formula names, not command names
PACKAGES=(
    fish
    starship
    direnv
    tmux
    neovim
    # LazyVim's recommended companions: lazygit backs its <leader>gg git UI,
    # tree-sitter-cli lets it build parsers that ship no prebuilt grammar.
    # fd and ripgrep are already below -- LazyVim wants those too.
    lazygit
    tree-sitter-cli
    # ast-grep backs grug-far's structural search; wget is mason's fallback
    # downloader when curl is unavailable. Both only surface as :checkhealth
    # warnings, but they are cheap to have.
    ast-grep
    wget
    eza
    bat
    fd
    ripgrep
    zoxide
    fzf
    atuin
    git-delta
    dust
    chezmoi
)

missing=()
for p in "${PACKAGES[@]}"; do
    brew list --versions "$p" >/dev/null 2>&1 || missing+=("$p")
done

if [[ ${#missing[@]} -gt 0 ]]; then
    echo "==> Installing: ${missing[*]}"
    brew install "${missing[@]}"
else
    echo "==> All packages already installed"
fi
{{- else }}
echo "==> Skipping package install: not macOS ({{ .chezmoi.os }})"
{{- end }}
